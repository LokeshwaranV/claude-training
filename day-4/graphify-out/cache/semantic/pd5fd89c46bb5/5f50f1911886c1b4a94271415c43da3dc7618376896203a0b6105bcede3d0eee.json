{"nodes": [{"id": "skills", "label": "SKILLS.md Governing Rules", "file_type": "document", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_allowlist_only_retrieval", "label": "Allowlist-Only Retrieval (Commitment 1)", "file_type": "rationale", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documents outside the allowlist must never reach generation; retriever filters to approved:true before ranking to prevent unapproved sources influencing answers."}, {"id": "skills_claim_level_grounding", "label": "Claim-Level Grounding (Commitment 2)", "file_type": "rationale", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every generated sentence must resolve to a citation in the allowlist; an unresolvable citation is invalid output, not a warning, to guarantee auditability for legally-challengeable claims."}, {"id": "skills_structured_output", "label": "Structured Output (Commitment 3)", "file_type": "rationale", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-text answers are treated as a bug; fixed schema keeps downstream consumers (UI, MCP tools) able to rely on a consistent contract."}, {"id": "skills_fail_gracefully", "label": "Fail Gracefully (Commitment 4)", "file_type": "rationale", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When evidence/confidence is insufficient, refuse or escalate instead of fabricating, to avoid unsupported claims in a pharma/legal context."}, {"id": "skills_cross_domain_browsing", "label": "Cross-Domain Browsing (Commitment 5)", "file_type": "rationale", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browsing by source_type is a standalone, list-only exploration mode separate from query/answer, still respecting the allowlist, so users can explore the corpus without triggering generation."}, {"id": "skills_response_schema", "label": "QueryResponse Schema (answer/confidence/citations/caveats/status)", "file_type": "concept", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_source_registry_expectations", "label": "Source Registry Expectations", "file_type": "rationale", "source_file": "SKILLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "version/superseded_by fields required to catch version drift across multi-source ingestion (literature, patent, clinical_trial, internal_report)."}], "edges": [{"source": "skills", "target": "skills_allowlist_only_retrieval", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SKILLS.md", "source_location": null, "weight": 1.0}, {"source": "skills", "target": "skills_claim_level_grounding", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SKILLS.md", "source_location": null, "weight": 1.0}, {"source": "skills", "target": "skills_structured_output", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SKILLS.md", "source_location": null, "weight": 1.0}, {"source": "skills", "target": "skills_fail_gracefully", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SKILLS.md", "source_location": null, "weight": 1.0}, {"source": "skills", "target": "skills_cross_domain_browsing", "relation": "conceptually_relat