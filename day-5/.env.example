# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here

# Groq API (Fast inference with open-source models)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama3.1
# Available Groq models: llama3.1 (recommended), llama3, mixtral

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/chat.db
POSTGRES_URL=postgresql://user:password@localhost:5432/elation_chatbot

# Frontend
REACT_APP_API_URL=http://localhost:8000

# Elation Health API (when integrated)
ELATION_API_KEY=your_elation_key_here
ELATION_API_URL=https://api.elationhealth.com

# Session Management
SESSION_STORAGE_PATH=./data/sessions
MAX_SESSION_AGE_DAYS=30

# Security
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256

# Features
ENABLE_VOICE_INPUT=false
ENABLE_NOTE_GENERATION=true
ENABLE_VALIDATION=true

# Multi-Agent Orchestration
ENABLE_ORCHESTRATION=true
ORCHESTRATION_MODE=strict

# RAG Engine Configuration
RAG_ENABLED=true
RAG_BACKEND=llamaindex
RAG_VECTOR_DB=chromadb
RAG_CHUNK_SIZE=512
RAG_OVERLAP=50
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Observability - OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=elation-chatbot

# Observability - Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Caching
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# MCP Server
MCP_ENABLED=true
MCP_PORT=8001

# Context Management
CONTEXT_TRIMMING_ENABLED=true
CONTEXT_SUMMARY_RATIO=0.15
CONTEXT_KEEP_RECENT_PROMPTS=10
MAX_CONTEXT_TOKENS=12000

# Performance & Limits
API_RATE_LIMIT=100
API_RATE_WINDOW_SECONDS=60
MAX_MESSAGE_LENGTH=5000
BATCH_SIZE=32

# Compliance
HIPAA_MODE=true
AUDIT_LOGGING=true
DATA_RETENTION_DAYS=30
ENCRYPTION_ALGORITHM=AES-256

# Analytics & Monitoring
METRICS_ENABLED=true
METRICS_INTERVAL_SECONDS=60
TRACES_ENABLED=true
TRACES_SAMPLE_RATE=1.0
